# Supabase — te vinden in je Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Settings → API → service_role secret) — NOOIT client-side gebruiken/blootstellen
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Stripe — https://dashboard.stripe.com/ (start in test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Basis-URL van de app, gebruikt voor e-mail-redirects en Stripe checkout/portal-redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
